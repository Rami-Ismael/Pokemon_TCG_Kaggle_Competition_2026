# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Data & large artifacts (keep directory structure via .gitkeep)
data/**
!data/**/
!data/**/.gitkeep
# Rung-2 opponent-pool registry: small, curated, version-worthy provenance
# (built by scripts/build_opponent_pool.py, consumed by benchmark_agents.py).
!data/opponent_pool.csv
# Vendored `cg` engine (3.8 MB: 3 prebuilt libcg binaries + ~30 KB of Python).
# Tracked so `git worktree add` checkouts get it for free -- ~15 call sites
# resolve PROJECT_ROOT/data/external/cg-lib with no fallback and fail without it.
!data/external/cg-lib/**
data/external/cg-lib/**/__pycache__/
models/**
!models/
!models/.gitkeep
submissions/**
!submissions/
!submissions/.gitkeep
reports/figures/**
!reports/figures/
!reports/figures/.gitkeep
# Raw game traces: ~4 MB each, and the analysis scripts regenerate them from a
# checkpoint. Eval JSONs (the numbers) ARE tracked; the replays behind them are
# not -- matching how reports/exploiter/replays (v1) was already handled.
reports/**/replays*/
# Trainer stdout is mostly PufferLib TUI redraws (3 MB of escape codes per run).
# Commit the distilled *_queue.log instead.
reports/*_launch.log
runs/

# Kaggle credentials
kaggle.json

# Notebook / IDE artifacts
.ipynb_checkpoints/
__marimo__/
.DS_Store
.ruff_cache/

# Personal Claude Code overrides (project-shared config lives in .claude/settings.json)
.claude/settings.local.json
